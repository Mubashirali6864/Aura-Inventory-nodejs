app.post('/api/supplier-payments', async (req, res) => {
    try {
        const { supplierId, amount } = req.body || {};
        if (!supplierId) {
            return res.status(400).json({ error: 'Supplier ID is required.' });
        }
        const parsedAmount = Number(amount);
        if (isNaN(parsedAmount) || parsedAmount <= 0) {
            return res.status(400).json({ error: 'Payment amount must be a positive number.' });
        }

        const supplier = await getById('suppliers', supplierId);
        if (!supplier) {
            return res.status(404).json({ error: 'Supplier not found.' });
        }

        const currentBalance = Number(supplier.balance) || 0;
        if (currentBalance <= 0) {
            return res.status(400).json({ error: 'Cannot pay supplier: Supplier has no pending dues (balance is 0 or negative).' });
        }

        const paymentId = generateId();
        const payment = { ...stripUndefined(req.body), amount: parsedAmount, createdAt: Date.now() };
        await insert('supplierPayments', paymentId, payment);

        await update('suppliers', supplierId, {
            balance: currentBalance - parsedAmount,
            totalPaid: (Number(supplier.totalPaid) || 0) + parsedAmount
        });
        res.status(201).json({ id: paymentId, ...payment });
    } catch (error) { res.status(500).json({ error: error.message }); }
});

